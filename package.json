{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "myme",
  "title": "Myme",
  "description": "Browse, search, and capture items in your Myme data layer",
  "icon": "icon.png",
  "author": "aic",
  "categories": [
    "Productivity",
    "Data"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "browse",
      "title": "Browse",
      "subtitle": "Myme",
      "description": "Browse your Myme items in reverse chronological order",
      "mode": "view"
    },
    {
      "name": "search",
      "title": "Search",
      "subtitle": "Myme",
      "description": "Search across your Myme items",
      "mode": "view"
    },
    {
      "name": "quick-capture",
      "title": "Quick Capture",
      "subtitle": "Myme",
      "description": "Capture a note, bookmark, task, or event",
      "mode": "view"
    },
    {
      "name": "clipboard-capture",
      "title": "Clipboard Capture",
      "subtitle": "Myme",
      "description": "Capture clipboard content as a bookmark or note",
      "mode": "no-view"
    }
  ],
  "preferences": [
    {
      "name": "apiUrl",
      "title": "Server URL",
      "description": "Myme server URL",
      "type": "textfield",
      "required": true,
      "default": "http://localhost:8600",
      "placeholder": "http://localhost:8600"
    },
    {
      "name": "apiKey",
      "title": "API Key",
      "description": "Myme API key for authentication",
      "type": "password",
      "required": true
    }
  ],
  "dependencies": {
    "@mymehq/sdk": "^3.0.0",
    "@raycast/api": "^1.104.0",
    "@raycast/utils": "^2.2.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "eslint": "^9.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build -o ./dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix --relaxed",
    "lint": "ray lint --relaxed"
  }
}