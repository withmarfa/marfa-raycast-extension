{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "myme",
  "title": "Myme",
  "description": "Browse, search, and capture items in your Myme data layer",
  "icon": "icon.png",
  "author": "aicayzer",
  "categories": ["Productivity", "Data"],
  "license": "MIT",
  "commands": [
    {
      "name": "browse",
      "title": "Browse",
      "subtitle": "Myme",
      "description": "Browse your Myme items in reverse chronological order",
      "mode": "view"
    },
    {
      "name": "search",
      "title": "Search",
      "subtitle": "Myme",
      "description": "Search across your Myme items",
      "mode": "view"
    },
    {
      "name": "quick-capture",
      "title": "Quick Capture",
      "subtitle": "Myme",
      "description": "Capture a note, bookmark, task, or event",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "apiUrl",
      "title": "Server URL",
      "description": "Myme server URL",
      "type": "textfield",
      "required": true,
      "default": "http://localhost:8200",
      "placeholder": "http://localhost:8200"
    },
    {
      "name": "apiKey",
      "title": "API Key",
      "description": "Myme API key for authentication",
      "type": "password",
      "required": true
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.0",
    "@raycast/utils": "^2.2.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^8.57.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint"
  }
}
